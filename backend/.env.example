PORT=4000
JWT_SECRET=2002
APP_URL=http://localhost:5173
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_READ_LIMIT=200

# Optional SMTP settings. Invitations are logged to the terminal when omitted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Classmark <no-reply@classmark.local>

# AWS Rekognition. On EC2, use an attached IAM role; do not add permanent AWS keys.
AWS_REGION=ap-south-1
REKOGNITION_COLLECTION_ID=classmark-faces
COGNITO_IDENTITY_POOL_ID=
FACE_LIVENESS_THRESHOLD=80
FACE_LIVENESS_CHALLENGE=movement
FACE_MATCH_THRESHOLD=88
FACE_AMBIGUITY_MARGIN=3

# Comma-separated existing account emails promoted to administrator on startup.
ADMIN_EMAILS=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Classmark
